{
  "version": 2,
  "cleanUrls": true,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/api/doctors/:id",
      "destination": "/api/doctors?id=:id"
    },
    {
      "source": "/api/appointments/:id",
      "destination": "/api/appointments?id=:id"
    },
    {
      "source": "/api/prescriptions/:id",
      "destination": "/api/prescriptions?id=:id"
    }
  ]
}